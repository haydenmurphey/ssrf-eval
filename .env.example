# Copy to .env and fill in. .env is gitignored and holds credentials only.
# The per-run SECRET_API_KEY is NOT configured here — it is generated at runtime.

# Langfuse Cloud (US region)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Ollama runs locally on this M1 (installed via `brew install ollama`, served by
# `brew services start ollama`). Models: qwen2.5:7b-instruct, llama3.2:3b.
# Leave this as-is for a local Ollama; no key needed. Override only if Ollama is remote.
OLLAMA_BASE=http://localhost:11434

# Free-tier API model (gemini-3.8-flash). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
